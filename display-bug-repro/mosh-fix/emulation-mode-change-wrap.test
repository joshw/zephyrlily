#!/bin/sh

#
# An ANSI mode change (SM/RM, ESC [ 4 h and ESC [ 4 l) must not discard a
# pending wrap.
#
# After a character is written to the last column the cursor stays there with
# the wrap owing, and the next printable character consumes it and moves to the
# next row. Setting or resetting a mode is not a cursor movement and has no
# business affecting that.
#
# mosh clears the flag on every CSI h / CSI l, so the character that should
# wrap instead overwrites the last column. DECSET/DECRST (ESC [ ? 2 5 h) and
# SGR are already registered as not clearing it; the ANSI forms were left at
# the default.
#

# shellcheck source=e2e-test-subrs
. "$(dirname "$0")/e2e-test-subrs"
PATH=$PATH:.:$srcdir
# Top-level wrapper.
if [ $# -eq 0 ]; then
    e2e-test "$0" baseline direct verify
    exit
fi

# OK, we have arguments, we're one of the test hooks.
if [ $# -ne 1 ]; then
    fail "bad arguments %s\n" "$@"
fi

baseline()
{
    printf '\033[H\033[J'
    sleepf
    # Fill row 1 to the last column; the cursor stays on column 80 with the
    # wrap owing.
    printf '\033[1;1H'
    i=1
    while [ "$i" -le 8 ]; do
	printf '1234567890'
	i=$(( i + 1 ))
    done
    sleepf
    # Not a cursor movement.
    printf '\033[4l'
    sleepf
    # Consumes the pending wrap: belongs at row 2, column 1.
    printf 'X'
    sleepf
    printf '\033[24;1Hdone'
    sleepf
}

case $1 in
    baseline|direct)
	baseline;;
    *)
	fail "unknown test argument %s\n" "$1";;
esac
