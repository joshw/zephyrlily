#!/bin/sh

#
# A frame update that ends by writing the bottom-right cell must leave the
# client's cursor where the server believes it is.
#
# Mosh synchronizes terminal state by shipping the byte string that
# Display::new_frame emits and replaying it into the client's own emulator, so
# new_frame must round-trip: state A plus the emitted bytes must reproduce
# state B exactly, cursor included. After the last cell of the bottom row is
# written, new_frame's bookkeeping holds the cursor one past the last column,
# while a terminal's cursor snaps to the last column with a wrap pending.
# append_move then renders the one-column difference as a backspace, which
# lands one cell short -- and every later frame that uses relative motion from
# there corrupts cells that should have survived.
#
# All cursor addressing below is absolute, so the relative motion under test
# exists only inside mosh's generated diffs; the direct rendering of these
# bytes is unambiguous.
#

# shellcheck source=e2e-test-subrs
. "$(dirname "$0")/e2e-test-subrs"
PATH=$PATH:.:$srcdir
# Top-level wrapper.
if [ $# -eq 0 ]; then
    e2e-test "$0" baseline direct verify
    exit
fi

# OK, we have arguments, we're one of the test hooks.
if [ $# -ne 1 ]; then
    fail "bad arguments %s\n" "$@"
fi

baseline()
{
    printf '\033[H\033[Jpreamble'
    sleepf
    # Fill the bottom row to the last column, in its own frame. The diff for
    # this frame writes the bottom-right cell and then moves the cursor back
    # to the last column -- the motion that goes wrong.
    printf '\033[25;1H'
    i=1
    while [ "$i" -le 8 ]; do
	printf '1234567890'
	i=$(( i + 1 ))
    done
    sleepf
    # Rewrite the last three columns, absolutely addressed. The diff for this
    # frame reaches them with relative motion from wherever the previous frame
    # actually left the cursor.
    printf '\033[25;78Habc'
    sleepf
    printf '\033[1;1Hdone'
    sleepf
}

case $1 in
    baseline|direct)
	baseline;;
    *)
	fail "unknown test argument %s\n" "$1";;
esac
