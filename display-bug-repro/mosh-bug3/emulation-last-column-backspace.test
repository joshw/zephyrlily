#!/bin/sh

#
# A frame that shortens a full row by one character must not be rendered with a
# relative cursor motion computed from the autowrap column.
#
# After the last cell of a row is written, mosh's frame bookkeeping holds the
# cursor one past the last column, while a terminal's cursor has snapped to the
# last column with a wrap owing. append_move turns a one-column step into a
# backspace; issued from the true last column it lands a cell early, and the
# erase that follows takes a cell that should have survived.
#
# The symptom is an editor's input line losing a character when it is trimmed
# back from the right margin.
#

# shellcheck source=e2e-test-subrs
. "$(dirname "$0")/e2e-test-subrs"
PATH=$PATH:.:$srcdir
# Top-level wrapper.
if [ $# -eq 0 ]; then
    e2e-test "$0" baseline direct verify
    exit
fi

# OK, we have arguments, we're one of the test hooks.
if [ $# -ne 1 ]; then
    fail "bad arguments %s\n" "$@"
fi

baseline()
{
    printf '\033[H\033[J'
    sleepf
    # Fill the bottom row to the last column. Each sleepf is a frame boundary,
    # and the fault needs the fill and the trim to land in separate frames.
    printf '\033[24;1H'
    i=1
    while [ "$i" -le 8 ]; do
	printf '1234567890'
	i=$(( i + 1 ))
    done
    sleepf
    # Trim the row back by one, the way a line editor redraws after a delete.
    printf '\b \033[K'
    sleepf
    printf '\033[1;1Hdone'
    sleepf
}

case $1 in
    baseline|direct)
	baseline;;
    *)
	fail "unknown test argument %s\n" "$1";;
esac
